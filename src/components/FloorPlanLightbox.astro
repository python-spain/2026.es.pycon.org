---
interface Props {
  src: string
  alt: string
  title: string
  expandLabel: string
  closeLabel: string
  zoomInLabel: string
  zoomOutLabel: string
  resetLabel: string
  hint: string
}

const { src, alt, title, expandLabel, closeLabel, zoomInLabel, zoomOutLabel, resetLabel, hint } = Astro.props

const dialogId = `floor-plan-dialog-${Math.random().toString(36).slice(2, 9)}`
---

<button
  type="button"
  class="floor-plan-trigger group relative block w-full overflow-hidden rounded-lg bg-white cursor-zoom-in"
  data-floor-plan-trigger={dialogId}
  aria-haspopup="dialog"
>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
    class="w-full h-auto block transition-transform duration-300 group-hover:scale-[1.03]"
  />
  <span
    class="pointer-events-none absolute bottom-3 right-3 flex items-center gap-2 rounded-full bg-pycon-black/80 px-3 py-2 text-xs font-semibold text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4M10 10h4"></path>
    </svg>
    {expandLabel}
  </span>
</button>

<dialog
  id={dialogId}
  class="floor-plan-dialog m-auto w-screen max-w-none h-screen max-h-none p-0 bg-transparent backdrop:bg-pycon-black/95"
  aria-label={title}
>
  <div class="floor-plan-viewport absolute inset-0 overflow-hidden">
    <img
      src={src}
      alt={alt}
      class="floor-plan-image absolute left-1/2 top-1/2 max-w-none select-none will-change-transform"
      draggable="false"
    />
  </div>

  <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-4 p-4 pointer-events-none">
    <p class="pointer-events-auto rounded-lg bg-pycon-black/80 px-4 py-2 text-sm font-semibold text-white">
      {title}
    </p>
    <button
      type="button"
      class="pointer-events-auto rounded-lg bg-pycon-black/80 p-2 text-white hover:bg-pycon-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pycon-yellow"
      data-close
      aria-label={closeLabel}
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <div
    class="absolute bottom-4 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 pointer-events-none"
  >
    <p class="pointer-events-none rounded-lg bg-pycon-black/80 px-3 py-1 text-xs text-pycon-gray-25">
      {hint}
    </p>
    <div class="pointer-events-auto flex items-center gap-2 rounded-full bg-pycon-black/80 p-2">
      <button
        type="button"
        class="rounded-full bg-white/10 p-2 text-white hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pycon-yellow"
        data-zoom-out
        aria-label={zoomOutLabel}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14"></path>
        </svg>
      </button>
      <output
        class="min-w-16 text-center text-sm font-semibold text-white tabular-nums"
        data-zoom-level
        aria-live="polite">100%</output
      >
      <button
        type="button"
        class="rounded-full bg-white/10 p-2 text-white hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pycon-yellow"
        data-zoom-in
        aria-label={zoomInLabel}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14"></path>
        </svg>
      </button>
      <button
        type="button"
        class="rounded-full bg-white/10 px-4 py-2 text-xs font-semibold text-white hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pycon-yellow"
        data-zoom-reset
        aria-label={resetLabel}
      >
        {resetLabel}
      </button>
    </div>
  </div>
</dialog>

<style>
  .floor-plan-dialog::backdrop {
    background-color: rgb(0 0 0 / 0.95);
  }

  .floor-plan-dialog[open] {
    animation: floor-plan-fade-in 0.2s ease-out;
  }

  .floor-plan-viewport {
    cursor: grab;
    /* The gestures are handled in JS: blocking the native ones keeps the
       browser from zooming the page behind the dialog. */
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  .floor-plan-viewport.is-panning {
    cursor: grabbing;
  }

  @keyframes floor-plan-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  const MIN_ZOOM = 1
  const MAX_ZOOM = 4
  const ZOOM_STEP = 0.5
  const DOUBLE_TAP_DELAY = 300
  const DOUBLE_TAP_SLOP = 30

  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value))

  const setupFloorPlan = (dialog: HTMLDialogElement) => {
    const viewport = dialog.querySelector<HTMLElement>('.floor-plan-viewport')
    const image = dialog.querySelector<HTMLImageElement>('.floor-plan-image')
    const zoomLevel = dialog.querySelector<HTMLOutputElement>('[data-zoom-level]')
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-close]')
    const zoomInButton = dialog.querySelector<HTMLButtonElement>('[data-zoom-in]')
    const zoomOutButton = dialog.querySelector<HTMLButtonElement>('[data-zoom-out]')
    const resetButton = dialog.querySelector<HTMLButtonElement>('[data-zoom-reset]')

    if (!viewport || !image || !zoomLevel) return

    let zoom = MIN_ZOOM
    let offsetX = 0
    let offsetY = 0

    // Active touch/pointer points, keyed by pointerId. One point pans the
    // plan, two points pinch-zoom it around the midpoint between them.
    const pointers = new Map<number, { x: number; y: number }>()
    let gestureStartPoint: { x: number; y: number } | null = null
    let gestureStartDistance = 0
    let gestureStartZoom = MIN_ZOOM
    let gestureStartMidpoint: { x: number; y: number } | null = null
    let gestureStartOffsetX = 0
    let gestureStartOffsetY = 0
    // Point of the plan that stays under the fingers while pinching, in
    // coordinates relative to the centre of the unscaled image.
    let gestureAnchorX = 0
    let gestureAnchorY = 0

    // Double tap detection, used to toggle between the fitted view and 200%.
    let lastTapTime = 0
    let lastTapX = 0
    let lastTapY = 0
    let doubleTapTimer: number | undefined
    // Marks the moment a touch double tap was handled, so the native
    // `dblclick` event that browsers synthesise afterwards can be ignored.
    let touchDoubleTapAt = 0

    const applyTransform = () => {
      image.style.transform = `translate(-50%, -50%) translate(${offsetX}px, ${offsetY}px) scale(${zoom})`
      zoomLevel.textContent = `${Math.round(zoom * 100)}%`
    }

    // Keep the plan from being dragged away from the viewport. On the axes
    // where the scaled plan is bigger than the viewport it is allowed to
    // overflow equally on both sides, but never pulled so far that an edge of
    // the viewport is left empty. On the axes where the plan is smaller it can
    // be moved freely, otherwise the pinch gesture would lose its anchor.
    const clampOffsets = () => {
      const viewportWidth = viewport.clientWidth
      const viewportHeight = viewport.clientHeight
      const renderedWidth = image.offsetWidth * zoom
      const renderedHeight = image.offsetHeight * zoom

      // When the plan is at least as big as the viewport on an axis it is
      // pinned to that axis, so the viewport is never left empty.
      const maxOffsetX =
        renderedWidth >= viewportWidth ? (renderedWidth - viewportWidth) / 2 : viewportWidth / 2
      const maxOffsetY =
        renderedHeight >= viewportHeight ? (renderedHeight - viewportHeight) / 2 : viewportHeight / 2

      offsetX = clamp(offsetX, -maxOffsetX, maxOffsetX)
      offsetY = clamp(offsetY, -maxOffsetY, maxOffsetY)
    }

    const fitToViewport = () => {
      if (!image) return
      const naturalWidth = image.naturalWidth || 1
      const naturalHeight = image.naturalHeight || 1
      const viewportWidth = viewport.clientWidth
      const viewportHeight = viewport.clientHeight
      if (!viewportWidth || !viewportHeight) {
        // The dialog is not laid out yet: fall back to the natural size.
        image.style.width = `${naturalWidth}px`
        image.style.height = `${naturalHeight}px`
        return
      }
      const scale = Math.min(viewportWidth / naturalWidth, viewportHeight / naturalHeight)
      image.style.width = `${naturalWidth * scale}px`
      image.style.height = `${naturalHeight * scale}px`
    }

    const reset = () => {
      zoom = MIN_ZOOM
      offsetX = 0
      offsetY = 0
      pointers.clear()
      fitToViewport()
      applyTransform()
    }

    // The dialog has no layout until it is open, so fit the plan once it is visible.
    dialog.addEventListener('floor-plan:open', () => {
      requestAnimationFrame(() => reset())
    })

    // Zoom to `nextZoom` keeping the point of the plan that currently sits
    // at (originX, originY) — in viewport coordinates — under that same
    // place on the screen.
    const setZoom = (nextZoom: number, originX = 0, originY = 0) => {
      const clamped = clamp(nextZoom, MIN_ZOOM, MAX_ZOOM)
      if (clamped === zoom) return
      // Point of the plan under the origin, relative to the centre of the
      // unscaled image.
      const anchorX = (originX - viewport.clientWidth / 2 - offsetX) / zoom
      const anchorY = (originY - viewport.clientHeight / 2 - offsetY) / zoom
      offsetX = originX - viewport.clientWidth / 2 - anchorX * clamped
      offsetY = originY - viewport.clientHeight / 2 - anchorY * clamped
      zoom = clamped
      clampOffsets()
      applyTransform()
    }

    const zoomAtCenter = (delta: number) => {
      setZoom(zoom + delta, viewport.clientWidth / 2, viewport.clientHeight / 2)
    }

    closeButton?.addEventListener('click', () => dialog.close())

    zoomInButton?.addEventListener('click', () => zoomAtCenter(ZOOM_STEP))
    zoomOutButton?.addEventListener('click', () => zoomAtCenter(-ZOOM_STEP))
    resetButton?.addEventListener('click', reset)

    viewport.addEventListener(
      'wheel',
      (event: WheelEvent) => {
        event.preventDefault()
        const rect = viewport.getBoundingClientRect()
        const originX = event.clientX - rect.left
        const originY = event.clientY - rect.top
        setZoom(zoom + (event.deltaY < 0 ? ZOOM_STEP : -ZOOM_STEP), originX, originY)
      },
      { passive: false },
    )

    const getPoint = (event: PointerEvent) => {
      const rect = viewport.getBoundingClientRect()
      return { x: event.clientX - rect.left, y: event.clientY - rect.top }
    }

    const getMidpoint = () => {
      const points = Array.from(pointers.values())
      if (points.length < 2) return null
      return {
        x: (points[0].x + points[1].x) / 2,
        y: (points[0].y + points[1].y) / 2,
      }
    }

    const getDistance = () => {
      const points = Array.from(pointers.values())
      if (points.length < 2) return 0
      return Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y)
    }

    // Snapshot of the gesture, used as the reference frame for pan and pinch.
    const startGesture = () => {
      const points = Array.from(pointers.values())
      gestureStartPoint = points[0] ?? null
      gestureStartMidpoint = points.length >= 2 ? getMidpoint() : null
      gestureStartDistance = points.length >= 2 ? getDistance() : 0
      gestureStartZoom = zoom
      gestureStartOffsetX = offsetX
      gestureStartOffsetY = offsetY

      if (gestureStartMidpoint) {
        // Remember which point of the plan sits under the fingers, in
        // coordinates relative to the centre of the unscaled image, so it can
        // be kept in place while the plan is scaled.
        gestureAnchorX = (gestureStartMidpoint.x - viewport.clientWidth / 2 - offsetX) / zoom
        gestureAnchorY = (gestureStartMidpoint.y - viewport.clientHeight / 2 - offsetY) / zoom
      }
    }

    const handlePointerDown = (event: PointerEvent) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return

      pointers.set(event.pointerId, getPoint(event))
      viewport.classList.add('is-panning')

      // A second finger turns the gesture into a pinch, so the reference
      // frame has to take both points into account.
      startGesture()
      if (pointers.size > 1) cancelDoubleTap()
    }

    const handlePointerMove = (event: PointerEvent) => {
      if (!pointers.has(event.pointerId)) return
      pointers.set(event.pointerId, getPoint(event))

      if (pointers.size >= 2) {
        // Pinch: scale continuously around the midpoint between the fingers.
        const midpoint = getMidpoint()
        const distance = getDistance()
        if (!midpoint || !gestureStartMidpoint || !gestureStartDistance) return

        const scaleFactor = distance / gestureStartDistance
        const nextZoom = clamp(gestureStartZoom * scaleFactor, MIN_ZOOM, MAX_ZOOM)

        // Keep the point of the plan that was under the fingers under the
        // fingers, following the midpoint as it moves.
        offsetX = midpoint.x - viewport.clientWidth / 2 - gestureAnchorX * nextZoom
        offsetY = midpoint.y - viewport.clientHeight / 2 - gestureAnchorY * nextZoom
        zoom = nextZoom
        clampOffsets()
        applyTransform()
        return
      }

      // Single finger: pan the plan.
      const point = pointers.get(event.pointerId)
      if (!point || !gestureStartPoint) return
      offsetX = gestureStartOffsetX + (point.x - gestureStartPoint.x)
      offsetY = gestureStartOffsetY + (point.y - gestureStartPoint.y)
      clampOffsets()
      applyTransform()
    }

    const handlePointerUp = (event: PointerEvent) => {
      const point = pointers.get(event.pointerId)
      pointers.delete(event.pointerId)

      if (pointers.size === 0) {
        viewport.classList.remove('is-panning')
        gestureStartPoint = null
        gestureStartMidpoint = null
        gestureStartDistance = 0
        if (event.pointerType !== 'mouse') {
          handleTap(point, event)
        }
      } else {
        // A finger was lifted mid-pinch: rebase the remaining gesture.
        startGesture()
      }
    }

    // Double tap toggles between the fitted view and 200%, centred on the tap.
    const handleTap = (point: { x: number; y: number } | undefined, event: PointerEvent) => {
      if (!point) return
      const now = Date.now()
      const isDoubleTap =
        now - lastTapTime < DOUBLE_TAP_DELAY &&
        Math.hypot(point.x - lastTapX, point.y - lastTapY) < DOUBLE_TAP_SLOP

      if (!isDoubleTap) {
        lastTapTime = now
        lastTapX = point.x
        lastTapY = point.y
        doubleTapTimer = window.setTimeout(() => {
          doubleTapTimer = undefined
        }, DOUBLE_TAP_DELAY)
        return
      }

      cancelDoubleTap()
      lastTapTime = 0
      touchDoubleTapAt = Date.now()
      if (zoom > MIN_ZOOM) {
        setZoom(MIN_ZOOM, point.x, point.y)
      } else {
        setZoom(2, point.x, point.y)
      }
      event.preventDefault()
    }

    const cancelDoubleTap = () => {
      if (doubleTapTimer !== undefined) {
        window.clearTimeout(doubleTapTimer)
        doubleTapTimer = undefined
      }
      lastTapTime = 0
    }

    viewport.addEventListener('pointerdown', handlePointerDown)
    // Listen on the window so the gesture keeps working when a finger slides
    // outside of the viewport. Pointer capture is avoided on purpose: it
    // misbehaves on iOS Safari once more than one pointer is involved.
    window.addEventListener('pointermove', handlePointerMove)
    window.addEventListener('pointerup', handlePointerUp)
    window.addEventListener('pointercancel', handlePointerUp)

    // Block the browser's own pinch and scroll gestures on the plan so they do
    // not zoom the page behind the dialog.
    viewport.addEventListener(
      'touchstart',
      (event: TouchEvent) => {
        if (event.touches.length > 1) event.preventDefault()
      },
      { passive: false },
    )
    viewport.addEventListener(
      'touchmove',
      (event: TouchEvent) => {
        if (event.touches.length > 1) event.preventDefault()
      },
      { passive: false },
    )
    viewport.addEventListener(
      'touchend',
      (event: TouchEvent) => {
        if (event.touches.length > 0) event.preventDefault()
      },
      { passive: false },
    )

    viewport.addEventListener('dblclick', (event: MouseEvent) => {
      // Browsers synthesise a `dblclick` after a touch double tap. That one
      // is already handled by `handleTap`, so it must not undo the zoom.
      const sourceCapabilities = (
        event as MouseEvent & {
          sourceCapabilities?: { firesTouchEvents?: boolean }
        }
      ).sourceCapabilities
      const isTouchGenerated = sourceCapabilities?.firesTouchEvents === true
      if (isTouchGenerated || Date.now() - touchDoubleTapAt < 500) return

      event.preventDefault()
      const rect = viewport.getBoundingClientRect()
      const originX = event.clientX - rect.left
      const originY = event.clientY - rect.top
      if (zoom > MIN_ZOOM) {
        setZoom(MIN_ZOOM, originX, originY)
      } else {
        setZoom(2, originX, originY)
      }
    })

    dialog.addEventListener('click', (event: MouseEvent) => {
      if (event.target === dialog) dialog.close()
    })

    dialog.addEventListener('close', () => {
      zoom = MIN_ZOOM
      offsetX = 0
      offsetY = 0
      pointers.clear()
      cancelDoubleTap()
      viewport.classList.remove('is-panning')
      applyTransform()
    })
  }

  const bindTriggers = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-floor-plan-trigger]').forEach((trigger) => {
      if (trigger.dataset.floorPlanBound === 'true') return
      const dialogId = trigger.dataset.floorPlanTrigger
      if (!dialogId) return
      const dialog = document.getElementById(dialogId) as HTMLDialogElement | null
      if (!dialog) return
      trigger.dataset.floorPlanBound = 'true'
      const open = () => {
        dialog.showModal()
        dialog.dispatchEvent(new CustomEvent('floor-plan:open'))
      }
      trigger.addEventListener('click', open)
    })
  }

  const initFloorPlans = () => {
    document.querySelectorAll<HTMLDialogElement>('.floor-plan-dialog').forEach((dialog) => {
      if (dialog.dataset.floorPlanReady === 'true') return
      dialog.dataset.floorPlanReady = 'true'
      setupFloorPlan(dialog)
    })
    bindTriggers()
  }

  initFloorPlans()
  document.addEventListener('astro:page-load', initFloorPlans)
</script>
